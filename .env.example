# Salin ke .env lalu isi. File .env TIDAK boleh masuk git.
# Nilai POSTGRES_*/REDIS_URL/MINIO_* harus SAMA dengan .env repo API — keduanya
# menunjuk container infra yang sama di network `qc-net`.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bankqc
POSTGRES_USER=bankqc
POSTGRES_PASSWORD=changeme

# Redis (broker Celery — port 6378, sama dengan compose repo API)
REDIS_URL=redis://redis:6378/0
CELERY_CONCURRENCY=8

# MinIO
MINIO_ENDPOINT=minio:4003
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET_TRANSCRIPTS=transcripts
MINIO_BUCKET_RESULTS=results
MINIO_BUCKET_CAMPAIGNS=campaigns
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_SALES_DATABASE=sales-database

# DWH API (Aplikasi A) — sumber reference data
DWH_API_BASE_URL=http://host.docker.internal:8002
DWH_API_TIMEOUT_SEC=10
DWH_API_CACHE_TTL_SEC=5

# LLM evaluasi transkrip (OpenAI-compatible / Azure)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_VERSION=2025-04-01-preview
LLM_TEMPERATURE=1.0
LLM_SEED=42
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT=1800

# OCR dokumen pendukung (endpoint/model boleh beda dari LLM_*).
# Kosongkan kalau ingin memakai nilai LLM_* / default fungsinya.
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
OCR_TEMPERATURE=
OCR_SEED=
OCR_REASONING_EFFORT=

# Registry & tag image (dipakai docker-compose; Jenkins mengisinya sendiri)
REGISTRY=local
TAG=latest
